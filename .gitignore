# -----------------------------------------------
# ----  gitignore  ------------------------------
# ----  https://git-scm.com/docs/gitignore  -----
# -----------------------------------------------

# Create gitignore files automatically for with
# https://www.toptal.com/developers/gitignore

/tmp/
/.assets/

# -----------------------------------------------
# ----  IDEs  -----------------------------------
# -----------------------------------------------

.idea/*
.vscode/*
!.vscode/settings.json

# -----------------------------------------------
# ----  Rules  ----------------------------------
# -----------------------------------------------

/rules/*
!/rules/core.mdc
!/rules/lang-python.mdc
!/rules/lang-rust.mdc
!/rules/lang-shell.mdc
!/rules/project-index.mdc
!/rules/style-ponytail.mdc
